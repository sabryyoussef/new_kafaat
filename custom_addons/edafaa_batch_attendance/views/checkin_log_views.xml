<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edafaa_attendance_checkin_log_list" model="ir.ui.view">
        <field name="name">edafaa.attendance.checkin.log.list</field>
        <field name="model">edafaa.attendance.checkin.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="result"/>
                <field name="batch_id"/>
                <field name="student_id"/>
                <field name="late"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_edafaa_attendance_checkin_log" model="ir.actions.act_window">
        <field name="name">QR Check-in Logs</field>
        <field name="res_model">edafaa.attendance.checkin.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_edafaa_attendance_checkin_log"
              name="QR Check-in Logs"
              parent="openeducat_attendance.menu_op_attendance"
              action="action_edafaa_attendance_checkin_log"
              sequence="90"/>
</odoo>
