<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trainee_sales_assign_wizard_form" model="ir.ui.view">
        <field name="name">trainee.sales.assign.wizard.form</field>
        <field name="model">trainee.sales.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Excel assign trainees to sales">
                <group>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group string="Result" invisible="not result_message">
                    <field name="result_message" nolabel="1"/>
                    <field name="success_count"/>
                    <field name="overwrite_count"/>
                    <field name="reject_count"/>
                    <field name="reject_file" filename="reject_filename"
                              invisible="not reject_file"/>
                    <field name="reject_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_download_template" type="object"
                            string="Download template" class="btn-secondary"/>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"
                            invisible="not data_file"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trainee_sales_assign_wizard" model="ir.actions.act_window">
        <field name="name">Excel assign to sales</field>
        <field name="res_model">trainee.sales.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_trainee_sales_assign_wizard"
              name="Excel assign to sales"
              parent="openeducat_core.menu_op_general_student"
              action="action_trainee_sales_assign_wizard"
              sequence="40"
              groups="sales_team.group_sale_manager,openeducat_core.group_op_back_office_admin"/>
</odoo>
