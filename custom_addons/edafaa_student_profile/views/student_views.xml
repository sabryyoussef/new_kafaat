<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_student_form_edafaa_profile_inherit" model="ir.ui.view">
        <field name="name">op.student.form.edafaa.profile.inherit</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'student-name')]" position="after">
                <group>
                    <field name="name_arabic" required="1" placeholder="الاسم بالعربي"/>
                    <field name="name_english" required="1" placeholder="Full name in English"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='name_english']/parent::group" position="after">
                <group string="Training Summary" name="training_summary">
                    <field name="training_status" widget="badge"
                           decoration-info="training_status == 'new'"
                           decoration-success="training_status == 'active'"
                           decoration-muted="training_status == 'completed'"/>
                    <field name="current_course_id" readonly="1"/>
                    <field name="current_batch_id" readonly="1"/>
                    <field name="running_course_count" readonly="1"/>
                    <field name="completed_course_count" readonly="1"/>
                </group>
            </xpath>
            <field name="birth_date" position="before">
                <field name="id_number" required="1"/>
            </field>
            <field name="birth_date" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="email" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="phone" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="street" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="country_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Family" name="family">
                    <group string="Parents">
                        <field name="parent_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Siblings">
                        <field name="sibling_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name_english"/>
                                <field name="name_arabic"/>
                                <field name="id_number"/>
                                <field name="email"/>
                                <field name="phone"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
