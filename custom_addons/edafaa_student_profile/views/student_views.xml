<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_student_form_edafaa_profile_inherit" model="ir.ui.view">
        <field name="name">op.student.form.edafaa.profile.inherit</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="priority" eval="35"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="certificate_count" invisible="1"/>
                <button name="action_view_certificates" type="object"
                        class="oe_stat_button" icon="fa-certificate"
                        invisible="certificate_count == 0">
                    <field name="certificate_count" widget="statinfo" string="Certificates"/>
                </button>
            </xpath>
            <xpath expr="//div[contains(@class, 'student-name')]" position="after">
                <group>
                    <field name="name_arabic" required="1" placeholder="الاسم بالعربي"/>
                    <field name="name_english" required="1" placeholder="Full name in English"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='name_english']/parent::group" position="after">
                <group string="Training Summary" name="training_summary">
                    <field name="specialization_id" string="التخصص"/>
                    <field name="registration_number" readonly="1"/>
                    <field name="source_type" readonly="1"/>
                    <field name="assigned_user_id" string="موظف المبيعات المسؤول"/>
                    <field name="application_status" string="حالة الطالب" widget="badge"
                           decoration-success="application_status == 'accepted'"
                           decoration-danger="application_status == 'rejected'"
                           decoration-warning="application_status == 'under_review'"
                           decoration-muted="application_status == 'cancelled'"/>
                    <field name="training_status" widget="badge"
                           decoration-info="training_status == 'new'"
                           decoration-success="training_status == 'active'"
                           decoration-muted="training_status == 'completed'"/>
                    <field name="current_course_id" readonly="1" string="المقرر الحالي"/>
                    <field name="current_batch_id" readonly="1"/>
                    <field name="running_course_count" readonly="1"/>
                    <field name="completed_course_count" readonly="1"/>
                </group>
            </xpath>
            <field name="birth_date" position="before">
                <field name="id_number" required="1" string="رقم الهوية"/>
                <field name="voucher_number" string="رقم قسيمة الاختبار"/>
            </field>
            <field name="birth_date" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="email" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="phone" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="string">رقم الهاتف</attribute>
                <attribute name="placeholder">رقم الهاتف</attribute>
            </field>
            <xpath expr="//label[@for='street']" position="attributes">
                <attribute name="string">العنوان</attribute>
            </xpath>
            <field name="street" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="string">الشارع</attribute>
                <attribute name="placeholder">الشارع</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="string">المدينة</attribute>
                <attribute name="placeholder">المدينة</attribute>
            </field>
            <field name="country_id" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="string">الدولة</attribute>
                <attribute name="placeholder">الدولة</attribute>
            </field>
            <field name="category_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="blood_group" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Family" name="family">
                    <group string="Parents">
                        <field name="parent_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Siblings">
                        <field name="sibling_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name_english"/>
                                <field name="name_arabic"/>
                                <field name="id_number" string="رقم الهوية"/>
                                <field name="email"/>
                                <field name="phone" string="رقم الهاتف"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='family']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='family']" position="after">
                <page string="Courses" name="courses">
                    <field name="course_detail_ids" nolabel="1" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="course_id"/>
                            <field name="batch_id"/>
                            <field name="roll_number"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'running'"
                                   decoration-muted="state == 'finished'"/>
                            <field name="academic_years_id" optional="show"/>
                            <field name="academic_term_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_op_student_tree_edafaa_op206" model="ir.ui.view">
        <field name="name">op.student.list.edafaa.op206</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_tree"/>
        <field name="priority" eval="95"/>
        <field name="arch" type="xml">
            <field name="title" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="string">الاسم بالإنجليزية</attribute>
            </field>
            <field name="name" position="after">
                <field name="name_arabic" string="الاسم بالعربية" optional="show"/>
                <field name="id_number" string="رقم الهوية" optional="show"/>
                <field name="voucher_number" string="رقم قسيمة الاختبار" optional="hide"/>
                <field name="application_status" string="حالة الطالب" optional="show"
                          widget="badge"
                          decoration-success="application_status == 'accepted'"
                          decoration-danger="application_status == 'rejected'"
                          decoration-warning="application_status == 'under_review'"
                          decoration-muted="application_status == 'cancelled'"/>
                <field name="assigned_user_id" string="موظف المبيعات المسؤول" optional="show"/>
                <field name="phone" string="رقم الهاتف" optional="show"/>
                <field name="street" string="العنوان" optional="show"/>
                <field name="specialization_id" string="التخصص" optional="show"/>
            </field>
            <field name="blood_group" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
