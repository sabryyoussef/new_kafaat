<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_registration_form_edafaa_profile_bridge" model="ir.ui.view">
        <field name="name">student.registration.form.edafaa.profile.bridge</field>
        <field name="model">student.registration</field>
        <field name="inherit_id" ref="student_enrollment_portal.view_student_registration_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']/parent::group" position="after">
                <group string="بيانات الملف المطلوبة">
                    <field name="id_number" string="رقم الهوية"
                           readonly="state == 'rejected' or student_id"/>
                    <field name="street" string="الشارع"
                           readonly="state == 'rejected' or student_id"/>
                    <field name="city" string="المدينة"
                           readonly="state == 'rejected' or student_id"/>
                    <field name="country_id" string="الدولة"
                           readonly="state == 'rejected' or student_id"/>
                    <field name="specialization_id" string="التخصص"
                           readonly="state == 'rejected' or student_id"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="string">رقم الهاتف</attribute>
            </xpath>
            <xpath expr="//field[@name='attachment_ids']/parent::page" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
