<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_team_view_form_lead_target" model="ir.ui.view">
        <field name="name">crm.team.form.lead.target</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sale.crm_team_salesteams_view_form"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <label for="invoiced_target" position="replace">
                <label for="lead_target" string="Lead Target"/>
            </label>
            <div id="invoiced_target" position="replace">
                <div class="o_row" id="lead_target">
                    <field name="lead_target" class="oe_inline"/>
                    <span class="flex-grow-1">leads / month</span>
                </div>
                <field name="lead_count_month" readonly="1"/>
                <field name="lead_target_progress" widget="progressbar" readonly="1"/>
                <field name="invoiced_target" invisible="1"/>
            </div>
        </field>
    </record>

    <record id="crm_team_view_kanban_dashboard_lead_target" model="ir.ui.view">
        <field name="name">crm.team.kanban.dashboard.lead.target</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sale.crm_team_view_kanban_dashboard"/>
        <field name="arch" type="xml">
            <field name="invoiced_target" position="replace">
                <field name="lead_target"/>
                <field name="lead_count_month"/>
            </field>
        </field>
    </record>
</odoo>
