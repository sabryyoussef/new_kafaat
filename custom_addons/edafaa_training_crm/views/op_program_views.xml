<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_op_program_form_edafaa_training" model="ir.ui.view">
        <field name="name">op.program.form.edafaa.training</field>
        <field name="model">op.program</field>
        <field name="inherit_id" ref="openeducat_core.view_op_program_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,review,approved,published,archived"/>
                <button name="action_submit_for_review" type="object"
                        string="Submit for Review" class="btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_approve" type="object"
                        string="Approve" class="btn-primary"
                        invisible="state != 'review'"/>
                <button name="action_publish" type="object"
                        string="Publish" class="btn-primary"
                        invisible="state != 'approved'"/>
                <button name="action_archive_program" type="object"
                        string="Archive"
                        invisible="state not in ('published', 'approved')"/>
                <button name="action_reset_to_draft" type="object"
                        string="Reset to Draft"
                        invisible="state == 'draft'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_linked_courses" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="course_count == 0">
                    <field name="course_count" widget="statinfo" string="Courses"/>
                </button>
            </xpath>

            <xpath expr="//sheet/group[@class='pt-3']/group[1]" position="inside">
                <field name="state" readonly="1"/>
                <field name="duration_text"/>
                <field name="training_language"/>
                <field name="max_trainees"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="وصف البرنامج" name="description_tab">
                    <group>
                        <field name="description_html" nolabel="1"/>
                    </group>
                    <group>
                        <field name="program_objectives"/>
                        <field name="career_outcomes"/>
                    </group>
                </page>
                <page string="الاعتمادات والشهادات" name="accreditations_tab">
                    <field name="accreditations_html" nolabel="1"/>
                </page>
                <page string="الفئة المستهدفة" name="target_audience_tab">
                    <field name="target_audience_html" nolabel="1"/>
                </page>
                <page string="طريقة التقديم" name="delivery_tab">
                    <group>
                        <field name="delivery_html" nolabel="1"/>
                        <field name="available_schedules"/>
                    </group>
                </page>
                <page string="التسعير والرسوم" name="pricing_tab">
                    <field name="pricing_html" nolabel="1"/>
                </page>
                <page string="متطلبات الالتحاق" name="credentials_tab">
                    <field name="credentials_html" nolabel="1"/>
                </page>
                <page string="التسويق والإعلان" name="marketing_tab">
                    <group>
                        <field name="brochure" filename="brochure_filename"/>
                        <field name="brochure_filename" invisible="1"/>
                        <field name="marketing_materials"/>
                    </group>
                </page>
                <page string="الإدارة الداخلية" name="administration_tab">
                    <group>
                        <field name="approved_by_id"/>
                        <field name="approved_date"/>
                        <field name="admin_notes"/>
                    </group>
                </page>
                <page string="Linked Courses" name="linked_courses_tab">
                    <field name="course_ids" nolabel="1">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="department_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_op_program_tree_edafaa_training" model="ir.ui.view">
        <field name="name">op.program.list.edafaa.training</field>
        <field name="model">op.program</field>
        <field name="inherit_id" ref="openeducat_core.view_op_program_tree"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="state" optional="show"/>
                <field name="training_language" optional="hide"/>
                <field name="course_count" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
