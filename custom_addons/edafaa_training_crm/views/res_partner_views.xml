<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_edafaa_student_bridge" model="ir.ui.view">
        <field name="name">res.partner.form.edafaa.student.bridge</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_student_record"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-graduation-cap"
                        invisible="not is_student or not op_student_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Student</span>
                    </div>
                </button>
            </div>
            <field name="is_student" position="after">
                <field name="birth_date" invisible="not is_student"/>
                <field name="id_number" invisible="1"/>
                <field name="op_student_id" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
